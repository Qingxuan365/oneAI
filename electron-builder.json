{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.onedesktop.workbench",
  "productName": "OneAI",
  "copyright": "Copyright © 2026 OneAI",
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": [
    "dist/**/*",
    "!dist/app-icon.jpg",
    "dist-electron/**/*",
    "resources/**/*",
    "!resources/app-icon.jpg",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/node-pty/**/*"
  ],
  "win": {
    "icon": "resources/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-Setup-${version}.exe"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.exe"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Qingxuan365",
      "repo": "oneAI"
    }
  ]
}
